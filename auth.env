import streamlit as st
import smtplib
import random
import os
from email.message import EmailMessage
from auditor.sync_engine import is_connected

def send_otp_email(receiver_email, otp):
    """Delivers the OTP via SMTP. Falls back to UI display if offline or missing credentials."""
    
    # 1. Offline Resilience Fallback
    if not is_connected():
        st.warning(f"⚠️ *Network Offline:* Emergency Local Access Token generated: *{otp}*")
        return True

    sender_email = os.environ.get("SMTP_EMAIL", "")
    sender_password = os.environ.get("SMTP_PASSWORD", "")
    smtp_server = os.environ.get("SMTP_SERVER", "smtp.gmail.com")
    smtp_port = int(os.environ.get("SMTP_PORT", 587))

    # 2. Development Fallback (If you don't configure .env with an email)
    if not sender_email or not sender_password:
        st.info(f"🛠️ *Dev Mode Active:* SMTP credentials missing from .env. Your OTP is: *{otp}*")
        return True

    # 3. Production SMTP Delivery
    try:
        msg = EmailMessage()
        msg.set_content(f"Your SustainaByte secure login OTP is: {otp}\n\nThis code will expire in 5 minutes.")
        msg['Subject'] = "SustainaByte Access OTP"
        msg['From'] = sender_email
        msg['To'] = receiver_email

        server = smtplib.SMTP(smtp_server, smtp_port)
        server.starttls()
        server.login(sender_email, sender_password)
        server.send_message(msg)
        server.quit()
        return True
    except Exception as e:
        st.error(f"❌ Mail delivery failed. Check network or credentials. (Error: {e})")
        return False

def require_auth():
    """State machine managing the Login -> Request OTP -> Verify OTP flow."""
    if "authenticated" not in st.session_state:
        st.session_state["authenticated"] = False
        st.session_state["otp_sent"] = False
        st.session_state["otp"] = None
        st.session_state["user_email"] = ""

    if st.session_state["authenticated"]:
        return True  # Proceed to the main app

    # Render Login Wall
    st.title("🔐 SustainaByte Login")
    st.write("Please authenticate with your registered email to access the auditor.")

    # Phase 1: Request Email
    if not st.session_state["otp_sent"]:
        email_input = st.text_input("Email Address:", placeholder="name@enterprise.com")
        if st.button("Send Verification OTP", type="primary"):
            if "@" in email_input and "." in email_input:
                generated_otp = str(random.randint(100000, 999999))
                st.session_state["otp"] = generated_otp
                st.session_state["user_email"] = email_input
                
                with st.spinner("Dispatching secure OTP..."):
                    if send_otp_email(email_input, generated_otp):
                        st.session_state["otp_sent"] = True
                        st.rerun()
            else:
                st.error("Please enter a valid email format.")
    
    # Phase 2: Verify OTP
    else:
        st.success(f"Verification code dispatched to *{st.session_state['user_email']}*")
        otp_input = st.text_input("Enter 6-digit OTP:", type="password", max_chars=6)
        
        col1, col2 = st.columns([1, 4])
        with col1:
            if st.button("Verify & Login", type="primary"):
                if otp_input == st.session_state["otp"]:
                    st.session_state["authenticated"] = True
                    st.rerun()
                else:
                    st.error("Invalid OTP. Please verify the code and try again.")
        with col2:
            if st.button("Change Email", type="secondary"):
                st.session_state["otp_sent"] = False
                st.rerun()

    # st.stop() halts all downstream execution in app.py until auth succeeds
    st.stop()
